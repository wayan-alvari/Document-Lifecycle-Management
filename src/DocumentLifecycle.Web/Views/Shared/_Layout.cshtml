@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Workspace";
    var currentRole = ApplicationRoles.All.FirstOrDefault(User.IsInRole) ?? "Demo user";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Document Lifecycle Management</title>
    <link rel="stylesheet" href="~/vendor/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/vendor/adminlte/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-white border-bottom" aria-label="Application header">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <button class="nav-link" type="button" data-lte-toggle="sidebar" aria-label="Toggle navigation">
                            <span class="menu-glyph" aria-hidden="true">☰</span>
                        </button>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item d-none d-md-block">
                        <span class="navbar-text text-body-secondary">@User.Identity?.Name · @currentRole</span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button class="btn btn-outline-primary btn-sm" type="submit">Sign out &amp; switch role</button>
                        </form>
                    </li>
                </ul>
            </div>
        </nav>

        <aside class="app-sidebar bg-dark shadow" data-bs-theme="dark" aria-label="Primary navigation">
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index" class="brand-link text-decoration-none">
                    <span class="brand-mark" aria-hidden="true">DL</span>
                    <span class="brand-text fw-semibold">Document Lifecycle</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-3">
                    <ul class="nav sidebar-menu flex-column" role="menu">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link active" aria-current="page">
                                <span class="nav-icon" aria-hidden="true">01</span>
                                <p>Lifecycle dashboard</p>
                            </a>
                        </li>
                    </ul>
                </nav>
                <div class="sidebar-note mx-3 mt-4 p-3 rounded-3">
                    <span class="d-block small text-uppercase fw-semibold">Current role</span>
                    <span>@currentRole</span>
                </div>
            </div>
        </aside>

        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                        <div>
                            <span class="eyebrow">Document Lifecycle Management</span>
                            <h1 class="h3 mb-0">@pageTitle</h1>
                        </div>
                        <nav aria-label="Breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">
                    <div class="alert reset-notice d-flex gap-3 align-items-start" role="status">
                        <span class="notice-dot mt-1" aria-hidden="true"></span>
                        <div>
                            <strong>Private demo workspace</strong>
                            <div>Demo data is isolated per browser and automatically resets after 6 hours of inactivity.</div>
                        </div>
                    </div>
                    @RenderBody()
                </div>
            </div>
        </main>

        <footer class="app-footer">
            <span>Independent clean-room portfolio · MIT licensed original source</span>
            <span class="float-end d-none d-sm-inline">© 2026 Wayan Alvari</span>
        </footer>
    </div>

    <script src="~/vendor/bootstrap/bootstrap.bundle.min.js" defer></script>
    <script src="~/vendor/adminlte/adminlte.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
