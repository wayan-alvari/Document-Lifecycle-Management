@model int

<a asp-controller="Notifications"
   asp-action="Index"
   class="notification-summary"
   aria-label="Notifications, @Model unread">
    <span aria-hidden="true">Alerts</span>
    @if (Model > 0)
    {
        <span class="notification-count">@(Model > 99 ? "99+" : Model)</span>
    }
</a>
