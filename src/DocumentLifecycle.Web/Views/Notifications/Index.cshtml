@model DocumentLifecycle.Application.Notifications.NotificationCenter
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <span class="eyebrow">Lifecycle alerts</span>
        <h2 class="h4 mt-2 mb-1">Notifications</h2>
        <p class="text-body-secondary mb-0">Review-date alerts are generated idempotently for your current demo role.</p>
    </div>
    @if (Model.UnreadCount > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            <button type="submit" class="btn btn-outline-primary">Mark all as read</button>
        </form>
    }
</div>

<section class="card notification-center border-0 shadow-sm" aria-labelledby="notification-list-heading">
    <div class="card-header bg-white border-0 d-flex align-items-center justify-content-between gap-3 p-4 pb-2">
        <h2 class="h5 mb-0" id="notification-list-heading">Review alerts</h2>
        <span class="count-chip">@Model.UnreadCount unread</span>
    </div>
    <div class="card-body p-4 pt-3">
        @if (Model.Items.Count == 0)
        {
            <div class="empty-state">
                <strong>No lifecycle alerts</strong>
                <span>Upcoming and passed review dates will appear here.</span>
            </div>
        }
        else
        {
            <ol class="notification-list list-unstyled mb-0">
                @foreach (var notification in Model.Items)
                {
                    <li class="@(notification.ReadAtUtc is null ? "notification-unread" : "notification-read")">
                        <span class="notification-state" aria-hidden="true"></span>
                        <div class="flex-grow-1">
                            <p class="mb-1">@notification.Message</p>
                            <time datetime="@notification.CreatedAtUtc.ToString("O")">@notification.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm 'UTC'")</time>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <a href="@notification.Link" class="btn btn-outline-primary btn-sm">Open document</a>
                                @if (notification.ReadAtUtc is null)
                                {
                                    <form asp-action="MarkRead" asp-route-id="@notification.PublicId" method="post">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Mark as read</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="read-label">Read</span>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ol>
        }
    </div>
</section>
