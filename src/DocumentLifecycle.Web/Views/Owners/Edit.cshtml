@model DocumentLifecycle.Web.ViewModels.ReferenceData.OwnerFormViewModel
@{
    ViewData["Title"] = "Edit owner";
    var publicId = (Guid)(ViewData["PublicId"] ?? Guid.Empty);
}

<div class="form-shell">
    <a asp-action="Index" class="back-link">&larr; Back to owners</a>
    <section class="card settings-card border-0 shadow-sm mt-3">
        <div class="card-body p-4 p-lg-5">
            <span class="eyebrow">Configuration</span>
            <h2 class="h4 mt-2">Edit owner</h2>
            <p class="text-body-secondary">Existing documents retain this owner when its details change.</p>
            <form asp-action="Edit" asp-route-id="@publicId" method="post" data-disable-on-submit>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="DisplayName" class="form-label"></label>
                    <input asp-for="DisplayName" class="form-control" autocomplete="off" autofocus />
                    <span asp-validation-for="DisplayName" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Contact" class="form-label"></label>
                    <input asp-for="Contact" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Contact" class="text-danger"></span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary" data-submit-label="Saving...">Save owner</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </section>
</div>
