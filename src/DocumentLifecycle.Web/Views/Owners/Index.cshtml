@model IReadOnlyList<DocumentLifecycle.Application.ReferenceData.OwnerListItem>
@{
    ViewData["Title"] = "Document owners";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <span class="eyebrow">Configuration</span>
        <h2 class="h4 mt-2 mb-1">Owners</h2>
        <p class="text-body-secondary mb-0">Maintain fictional teams responsible for document review.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add owner</a>
</div>

<section class="card settings-card border-0 shadow-sm" aria-labelledby="owner-list-heading">
    <div class="card-header bg-white border-0 p-4 pb-2">
        <h2 class="h5 mb-0" id="owner-list-heading">Available owners</h2>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="empty-state m-4">
                <strong>No owners configured</strong>
                <span>Add an owner before creating a document.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table settings-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Owner</th>
                            <th scope="col">Contact</th>
                            <th scope="col">Status</th>
                            <th scope="col">Documents</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var owner in Model)
                        {
                            <tr>
                                <td><strong>@owner.DisplayName</strong></td>
                                <td>@owner.Contact</td>
                                <td><span class="status-pill @(owner.IsActive ? "status-enabled" : "status-disabled")">@(owner.IsActive ? "Active" : "Inactive")</span></td>
                                <td>@owner.DocumentCount</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@owner.PublicId" class="btn btn-outline-primary btn-sm">Edit</a>
                                    <form asp-action="Toggle" asp-route-id="@owner.PublicId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">@(owner.IsActive ? "Deactivate" : "Reactivate")</button>
                                    </form>
                                    @if (owner.DocumentCount == 0)
                                    {
                                        <a asp-action="Delete" asp-route-id="@owner.PublicId" class="btn btn-outline-danger btn-sm">Delete</a>
                                    }
                                    else
                                    {
                                        <span class="small text-body-secondary ms-1" title="Referenced owners cannot be deleted">In use</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
