@model DocumentLifecycle.Web.Models.ErrorViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Request error";
}

<section class="status-card card border-0 shadow-sm mx-auto text-center" aria-labelledby="error-heading">
    <div class="card-body p-5">
        <span class="status-code" aria-hidden="true">500</span>
        <h1 class="h2" id="error-heading">We could not complete that request</h1>
        <p class="text-body-secondary">
            The problem has been recorded without exposing private diagnostics. Return to the workspace and try again.
        </p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-body-secondary">
                Reference: <code>@Model.RequestId</code>
            </p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return to workspace</a>
    </div>
</section>
